{
  "name": "finance_tracker",
  "version": "1.0.0",
  "description": "A simple FastAPI backend to serve APIs for a finance tracking application.",
  "main": "index.js",
  "scripts": {
    "start:dev:api": "uvicorn api.server:app --reload",
    "start:prod:api": "uvicorn api.server:app",
    "dev:frontend": "cd static && pnpm dev",
    "build:frontend": "cd static && npm install && npm build --emptyOutDir",
    "docker-up": "docker compose up -d mysql redis celery_worker celery_beat",
    "docker-down": "docker compose down",
    "start": "npm run docker-up && concurrently \"npm run start:dev:api\" \"npm run dev:frontend\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nommiiee/finance_tracker.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Nommiiee/finance_tracker/issues"
  },
  "homepage": "https://github.com/Nommiiee/finance_tracker#readme",
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "packageManager": "pnpm@10.16.1+sha512.0e155aa2629db8672b49e8475da6226aa4bdea85fdcdfdc15350874946d4f3c91faaf64cbdc4a5d1ab8002f473d5c3fcedcd197989cf0390f9badd3c04678706"
}
