{
  "name": "finance_tracker",
  "version": "1.0.0",
  "description": "A simple FastAPI backend to serve APIs for a finance tracking application.",
  "main": "index.js",
  "scripts": {
    "start:dev:api": "uvicorn api.server:app --reload",
    "start:prod:api": "uvicorn api.server:app ",
